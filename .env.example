# Copy this file to `.env` and fill in your credentials before running either bot.

# --- Required by both bots ---
XMPP_JID=bot@lobby.wildfiregames.com
XMPP_PASSWORD=<redacted>
XMPP_NICKNAME=GenieHelper

# --- Simple bot only ---
# Optional: override the default rooms (arena25, arena26, arena27, arena28, helpers).
#XMPP_ROOMS=arena25@conference.lobby.wildfiregames.com,arena26@conference.lobby.wildfiregames.com,arena27@conference.lobby.wildfiregames.com,helpers@conference.lobby.wildfiregames.com
# Optional: point to an alternate env file path (rarely needed).
#XMPP_ENV_FILE=/absolute/path/to/.env

# --- Full bot (main.py) only ---
# Primary room the full bot monitors.
#XMPP_ROOM=arena26@conference.lobby.wildfiregames.com
# Room where reports, alerts, and analytics go.
#XMPP_SPAM_REPORTS=reports@conference.lobby.wildfiregames.com
# Room overrides.
#XMPP_DEFAULT_TARGET_ROOM=arena26@conference.lobby.wildfiregames.com
#XMPP_ARENA25=arena25@conference.lobby.wildfiregames.com
#XMPP_ARENA27=arena27@conference.lobby.wildfiregames.com
# Enables AI replies (requires the `openai` package).
#OPENAI_API_KEY=
# Forum credentials for the analytics push command (requires the `selenium` package).
#FORUM_USER=
#FORUM_PASS=
